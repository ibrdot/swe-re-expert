# Inside a Maxgent sandbox, both variables are auto-injected by the runtime —
# you do not need to create a .env file in production.
#
# This template only matters for local development outside the sandbox:
# point APP_SERVER_URL at a running app-server, and use a sandbox MCP token
# that maps to a real agent in that database.

APP_SERVER_URL=http://localhost:8000
SANDBOX_MCP_TOKEN=your-sandbox-mcp-token
