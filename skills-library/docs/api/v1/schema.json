{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill collection API v1",
  "type": "object",
  "required": [
    "api_version",
    "revision",
    "skills",
    "counts"
  ],
  "properties": {
    "api_version": {
      "const": "1"
    },
    "revision": {
      "type": "string"
    },
    "counts": {
      "type": "object"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "name",
          "skill_file",
          "description",
          "content_sha256"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "skill_file": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "content_sha256": {
            "type": "string"
          }
        }
      }
    }
  }
}
